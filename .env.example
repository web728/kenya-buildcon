# Kenya Buildcon International Expo 2027 — environment variables
# Copy to .env.local for local development. Never commit real values.
# Full reference: ENVIRONMENT_VARIABLES.md

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://kenyabuildcon.com
# Google Search Console HTML-tag verification code for the kenyabuildcon.com property
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB=kenya_buildcon

# --- Admin auth (Auth.js) ---
# Generate with: npx auth secret
AUTH_SECRET=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- Google reCAPTCHA v2 (keys must be registered for the kenyabuildcon.com domain) ---
# Set both or neither: the widget renders only with the site key; the server enforces only with the secret.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Google Sheets sync (service account) ---
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Base64-encoded service-account JSON key
GOOGLE_CREDENTIALS_BASE64=
# Kenya operational spreadsheet (share it with the service account as Editor)
GOOGLE_SHEET_ID=
# Optional — defaults to "Website Enquiries"
GOOGLE_SHEET_TAB=

# --- Email (Nodemailer / Gmail) ---
# OAuth2 is used when all three MAIL_CLIENT_* / MAIL_REFRESH_TOKEN are set; otherwise MAIL_APP_PASSWORD.
MAIL_PROVIDER=gmail
MAIL_FROM_NAME=Kenya Buildcon
MAIL_FROM_EMAIL=
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REFRESH_TOKEN=
# The two organiser inboxes that receive every form submission
FORM_NOTIFICATION_EMAIL_1=
FORM_NOTIFICATION_EMAIL_2=

# --- Social links (optional — defaults to the official Kenya Buildcon profiles) ---
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# --- Analytics (optional; only loaded after cookie consent) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
