# Kenya Buildcon International Expo 2027 — environment variables
# Copy to .env.local for local development. Never commit real values.
# Full reference: ENVIRONMENT_VARIABLES.md

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://kenyabuildcon.com
# Google Search Console HTML-tag verification code for the kenyabuildcon.com property
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- MongoDB Atlas ---
